
<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SR Real Earn</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
*{box-sizing:border-box}
body{
  margin:0;background:#062519;color:#eaffef;
  font-family:Arial,sans-serif;padding:18px;
}
h2{color:#64edaa}
.card{
  background:linear-gradient(135deg,#124b30,#08744a);
  padding:24px;border-radius:18px;margin:18px 0;
  border:1px solid #24794e;
}
.balance{font-size:42px;font-weight:bold;color:#62edaa}
button{
  border:0;border-radius:12px;padding:15px 10px;
  background:#10a66a;color:white;font-size:16px;
  font-weight:bold;cursor:pointer;
}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.nav{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}
.nav button{font-size:12px;padding:12px 3px;background:#153e2c}
p{color:#b6d8c4}
#message{color:#7af4ad;min-height:24px}
</style>
</head>
<body>
<h2>🍀 SR REAL EARN</h2>
<p>Welcome to your earning dashboard!</p>

<div class="card">
  <p>TOTAL BALANCE · DEMO</p>
  <div class="balance" id="balance">0</div>
  <p>🌱 SR LEAF · Demo coins only</p>
</div>

<div class="actions">
  <button onclick="mine()">⚡ EARN</button>
  <button onclick="showPage('withdraw')">⇩ WITHDRAW</button>
</div>

<div class="card" id="content">
  <h3>⛏️ Mining</h3>
  <p>Tap Earn to collect demo coins.</p>
  <p id="message">Ready to start!</p>
</div>

<div class="nav">
  <button onclick="showPage('home')">🏠 Home</button>
  <button onclick="showPage('earn')">⚡ Earn</button>
  <button onclick="showPage('friends')">👥 Friends</button>
  <button onclick="showPage('me')">👤 Me</button>
</div>

<script>
const tg = window.Telegram?.WebApp;
if (tg) {
  tg.ready();
  tg.expand();
}

// Local demo only. Not a real account balance.
let coins = 0;
const balance = document.getElementById('balance');
const content = document.getElementById('content');
const message = document.getElementById('message');

function mine() {
  coins += 10;
  balance.textContent = coins.toLocaleString();
  message.textContent = '+10 demo coins collected!';
}

function showPage(page) {
  const pages = {
    home: '<h3>🍀 Home</h3><p>Your demo dashboard.</p>',
    earn: '<h3>⚡ Earn</h3><p>Press the Earn button to collect 10 demo coins.</p>',
    friends: '<h3>👥 Friends</h3><p>Referral feature will be added later.</p>',
    me: '<h3>👤 My Account</h3><p>Telegram Mini App demo.</p>',
    withdraw: '<h3>⇩ Withdraw</h3><p>This demo has no real withdrawals or cash value.</p>'
  };
  content.innerHTML = pages[page] || pages.home;
}

if (tg?.initDataUnsafe?.user) {
  document.querySelector('body > p').textContent =
    'Welcome, ' + (tg.initDataUnsafe.user.first_name || 'User') + '!';
}
</script>
</body>
</html>
